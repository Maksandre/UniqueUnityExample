<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Substrate.NET.Schnorrkel</id>
    <version>1.2.2</version>
    <authors>Cedric Decoster</authors>
    <license type="file">LICENSE</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://ajuna.io/</projectUrl>
    <description>Substrate .NET Schnorrkel is written in NETStandard2.0 to provide maximum compatibility</description>
    <repository type="git" url="https://github.com/ajuna-network/Ajuna.NetWallet" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="IndexRange" version="1.0.3" exclude="Build,Analyzers" />
        <dependency id="StrobeNet" version="0.0.2.4" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.5.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="IndexRange" version="1.0.3" exclude="Build,Analyzers" />
        <dependency id="StrobeNet" version="0.0.2.4" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.5.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="IndexRange" version="1.0.3" exclude="Build,Analyzers" />
        <dependency id="StrobeNet" version="0.0.2.4" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.5.4" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>